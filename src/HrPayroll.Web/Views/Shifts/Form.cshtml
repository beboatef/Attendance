@using HrPayroll.Domain.Entities
@model Shift
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "تعديل وردية" : "إضافة وردية";
    var dayNames = new[] { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };
    var selectedDays = Model.WorkingDaySet();
}
<div class="card">
    <div class="card-head">
        <h2>@ViewData["Title"]</h2>
        <a class="btn btn-ghost btn-sm" asp-action="Index">رجوع</a>
    </div>
    <div class="card-body">
        <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

            <div class="form-grid">
                <div class="field span-2">
                    <label asp-for="ShiftName">اسم الوردية</label>
                    <input asp-for="ShiftName" />
                    <span class="field-error">@Html.ValidationMessage("ShiftName")</span>
                </div>
                <div class="field">
                    <label asp-for="ShiftNumber">ترتيب الوردية</label>
                    <input asp-for="ShiftNumber" type="number" min="1" max="99" />
                </div>
                <div class="field">
                    <label asp-for="StartTime">وقت البداية</label>
                    <input asp-for="StartTime" type="time" value="@Model.StartTime.ToString(@"hh\:mm")" />
                </div>
                <div class="field">
                    <label asp-for="StandardHours">الساعات القياسية</label>
                    <input asp-for="StandardHours" type="number" step="0.5" min="0.5" max="24" />
                    <span class="hint">وقت النهاية يُحسب تلقائيًا = البداية + هذه المدة. مثال: 07:00 + 8 ساعات = 15:00</span>
                </div>
                <div class="field">
                    <label asp-for="EntryGraceMinutes">سماح الدخول (دقيقة)</label>
                    <input asp-for="EntryGraceMinutes" type="number" min="0" max="240" />
                </div>
                <div class="field">
                    <label asp-for="ExitGraceMinutes">سماح الخروج (دقيقة)</label>
                    <input asp-for="ExitGraceMinutes" type="number" min="0" max="240" />
                </div>
                <div class="field">
                    <label asp-for="OvertimeMultiplier">معامل الإضافي</label>
                    <input asp-for="OvertimeMultiplier" type="number" step="0.1" min="1" value="1" readonly />
                    <span class="hint">سياسة الشركة: 1 — لا مضاعفة للإضافي.</span>
                </div>
                <div class="field">
                    <label asp-for="OvertimeMinMinutes">أقل مدة إضافي معتبرة (دقيقة)</label>
                    <input asp-for="OvertimeMinMinutes" type="number" min="0" max="240" />
                </div>
                <div class="field">
                    <label asp-for="IsActive">نشطة</label>
                    <select asp-for="IsActive">
                        <option value="true">نشطة</option>
                        <option value="false">معطّلة</option>
                    </select>
                </div>
            </div>

            <div class="section-title">أيام عمل الوردية</div>
            <div class="btn-row">
                @for (var d = 0; d <= 6; d++)
                {
                    var isChecked = selectedDays.Contains((DayOfWeek)d);
                    <label class="badge @(isChecked ? "info" : "muted")" style="cursor:pointer;padding:6px 12px">
                        <input type="checkbox" name="day_@d" value="@d" checked="@isChecked" style="margin-inline-end:5px" />
                        @dayNames[d]
                    </label>
                }
            </div>
            <input type="hidden" asp-for="WorkingDays" id="workingDaysHidden" />

            <div class="section-title">ملاحظات</div>
            <textarea asp-for="Notes" rows="2"></textarea>

            <div class="btn-row" style="margin-top:18px">
                <button type="submit" class="btn btn-primary btn-lg">حفظ الوردية</button>
                <a class="btn btn-ghost btn-lg" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // تجميع أيام العمل المختارة في حقل واحد قبل الإرسال
        document.querySelector('form').addEventListener('submit', function () {
            var days = [];
            document.querySelectorAll('input[name^="day_"]:checked').forEach(function (cb) { days.push(cb.value); });
            document.getElementById('workingDaysHidden').value = days.sort().join(',');
        });
    </script>
}
