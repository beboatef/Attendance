@model List<Shift>
@{ ViewData["Title"] = "الورديات"; }
<div class="d-flex justify-content-between mb-3">
    <h5 class="mb-0">إدارة الورديات</h5>
    <a class="btn btn-success" asp-action="Create">إضافة وردية</a>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr><th>الاسم</th><th>البداية</th><th>النهاية</th><th>السماح (دقيقة)</th><th>ليلية</th><th>معامل الإضافي</th><th>الحالة</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ShiftName</td>
                    <td>@s.StartTime.ToString(@"hh\:mm")</td>
                    <td>@s.EndTime.ToString(@"hh\:mm")</td>
                    <td>@s.GraceMinutes</td>
                    <td>@(s.IsOvernight ? "نعم" : "لا")</td>
                    <td>@s.OvertimeMultiplier</td>
                    <td>@(s.IsActive ? "نشطة" : "معطّلة")</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">تعديل</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
