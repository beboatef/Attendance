@using HrPayroll.Domain.Entities
@model List<Shift>
@{
    ViewData["Title"] = "الورديات";
    var isAdmin = User.IsInRole(HrPayroll.Domain.Entities.AppRoles.Admin);
    ViewData["Subtitle"] = "مواعيد الورديات وفترات السماح";
}
<div class="page-hero">
    <div class="page-hero-ico" aria-hidden="true">◔</div>
    <div class="page-hero-body">
        <h2>إعداد الورديات</h2>
        <div class="sub">07:00–15:00 · 15:00–23:00 · 23:00–07:00 — الكشف تلقائي من البصمات</div>
    </div>
</div>
<div class="card">
    <div class="card-head">
        <div>
            <h2>إعداد الورديات</h2>
            <div class="sub">
                وقت النهاية يُحسب تلقائيًا من وقت البداية + الساعات القياسية. الورديتان الثانية والثالثة
                مواعيدهما غير محددة من الشركة — يجب على المسؤول ضبطهما.
            </div>
        </div>
        @if (isAdmin)
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">+ إضافة وردية</a>
        }
    </div>
    @if (Model.Count == 0)
    {
        ViewData["message"] = "لا توجد ورديات";
        ViewData["icon"] = "🔁";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr>
                    <th>#</th><th>الاسم</th><th>البداية</th><th>النهاية (محسوبة)</th><th>ساعات</th>
                    <th>سماح الدخول</th><th>سماح الخروج</th><th>ليلة؟</th><th>أيام العمل</th><th>معامل الإضافي</th><th>الحالة</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    var days = s.WorkingDaySet();
                    var dayNames = new[] { "أحد", "اثنين", "ثلاثاء", "أربعاء", "خميس", "جمعة", "سبت" };
                    <tr>
                        <td class="num">@s.ShiftNumber</td>
                        <td>@s.ShiftName</td>
                        <td class="num">@s.StartTime.ToString(@"hh\:mm")</td>
                        <td class="num">@s.EndTime.ToString(@"hh\:mm")</td>
                        <td class="num">@s.StandardHours</td>
                        <td class="num">@s.EntryGraceMinutes د</td>
                        <td class="num">@s.ExitGraceMinutes د</td>
                        <td>@(s.IsOvernight ? "نعم" : "لا")</td>
                        <td>@(days.Count == 0 ? "كل الأيام" : string.Join(" / ", dayNames.Where((_, i) => days.Contains((DayOfWeek)i))))</td>
                        <td class="num">@s.OvertimeMultiplier</td>
                        <td>@if (s.IsActive) { <span class="badge ok">نشطة</span> } else { <span class="badge muted">معطّلة</span> }</td>
                        <td class="btn-row">
                            @if (isAdmin)
                            {
                                <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@s.Id">تعديل</a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@s.Id" class="d-inline" data-confirm="تغيير حالة الوردية؟">
                                    <button type="submit" class="btn btn-ghost btn-sm">@(s.IsActive ? "تعطيل" : "تفعيل")</button>
                                </form>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(s.Notes))
                    {
                        <tr><td colspan="12" class="hint" style="padding-top:0">↳ @s.Notes</td></tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="card">
    <div class="card-head"><h3>قواعد سياسة الحضور المطبقة</h3></div>
    <div class="card-body">
        <ul>
            <li><strong>التأخير:</strong> الوصول داخل فترة السماح = صفر تأخير. تجاوز السماح = احتساب التأخير كاملًا من وقت بداية الوردية (لا يُخصم السماح).</li>
            <li><strong>الإضافي:</strong> الخروج داخل سماح الخروج = صفر إضافي. تجاوز السماح = احتساب الإضافي كاملًا من وقت نهاية الوردية.</li>
            <li><strong>المضاعفة:</strong> لا تُطبَّق أي مضاعفة على الإضافي — يُدفع بسعر الساعة العادي (الأجر اليومي ÷ ساعات العمل).</li>
            <li><strong>الاعتماد:</strong> الإضافي لا يدخل الراتب إلا بعد اعتماد صريح من شاشة اعتماد الإضافي.</li>
        </ul>
    </div>
</div>
