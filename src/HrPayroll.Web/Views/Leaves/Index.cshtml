@using HrPayroll.Domain.Enums
@model HrPayroll.Web.ViewModels.LeaveIndexViewModel
@{
    ViewData["Title"] = "الإجازات";
}
<div class="card">
    <div class="card-head">
        <div>
            <h2>إدارة الإجازات</h2>
            <div class="sub">طلبات معلّقة: @Model.PendingCount — أيام عمل معتمدة: @Model.ApprovedWorkingDays</div>
        </div>
        <div class="btn-row">
            <a class="btn btn-soft btn-sm" asp-action="ConvertAbsence">تحويل غياب إلى إجازة</a>
            <a class="btn btn-primary btn-sm" asp-action="Create">+ إضافة إجازة</a>
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="filters">
            <div class="field">
                <label>الموظف</label>
                <select name="employeeId" asp-items="Model.EmployeeList"><option value="">الكل</option></select>
            </div>
            <div class="field">
                <label>النوع</label>
                <select name="leaveType" asp-items="Model.LeaveTypeList"><option value="">الكل</option></select>
            </div>
            <div class="field">
                <label>الحالة</label>
                <select name="status" asp-items="Model.ApprovalList"><option value="">الكل</option></select>
            </div>
            <div class="field">
                <label>من تاريخ</label>
                <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="field">
                <label>إلى تاريخ</label>
                <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="field actions">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a class="btn btn-ghost" asp-action="Index">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h3>الطلبات (@Model.Leaves.Count)</h3>
        <input type="text" data-table-filter="#leaveTable" placeholder="بحث فوري..." style="max-width:260px" />
    </div>
    @if (Model.Leaves.Count == 0)
    {
        ViewData["message"] = "لا توجد طلبات إجازة مطابقة";
        ViewData["hint"] = "أضف إجازة جديدة أو حوّل أيام غياب مسجَّلة إلى إجازة معتمدة.";
        ViewData["actionUrl"] = Url.Action("Create");
        ViewData["actionText"] = "إضافة إجازة";
        ViewData["icon"] = "🌴";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data" id="leaveTable">
                <thead>
                <tr>
                    <th>الموظف</th><th>النوع</th><th>من</th><th>إلى</th><th>أيام</th><th>أيام عمل</th>
                    <th>مدفوعة</th><th>السبب</th><th>الحالة</th><th>اعتُمدت بواسطة</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var l in Model.Leaves)
                {
                    <tr>
                        <td>@(l.Employee?.FullName ?? "-")</td>
                        <td>@HrPayroll.Web.ViewModels.LeaveFormViewModel.LeaveTypeText(l.LeaveType)</td>
                        <td class="num">@l.StartDate.ToString("yyyy-MM-dd")</td>
                        <td class="num">@l.EndDate.ToString("yyyy-MM-dd")</td>
                        <td class="num">@l.DaysCount</td>
                        <td class="num">@l.WorkingDays</td>
                        <td>@(l.IsPaid ? "نعم" : "لا")</td>
                        <td class="wrap">@(l.Reason ?? "-")</td>
                        <td>
                            <span class="badge @(l.Status == ApprovalStatus.Approved ? "ok" : l.Status == ApprovalStatus.Rejected ? "bad" : "warn")">
                                @(l.Status == ApprovalStatus.Approved ? "معتمد" : l.Status == ApprovalStatus.Rejected ? "مرفوض" : "قيد المراجعة")
                            </span>
                            @if (l.CreatedFromAbsence)
                            {
                                <span class="badge info">من غياب</span>
                            }
                        </td>
                        <td>@(l.ApprovedBy ?? "-")</td>
                        <td class="btn-row">
                            @if (l.Status == ApprovalStatus.Pending)
                            {
                                <form method="post" asp-action="Approve" asp-route-id="@l.Id" class="d-inline">
                                    <button type="submit" class="btn btn-accent btn-sm">اعتماد</button>
                                </form>
                                <form method="post" asp-action="Reject" asp-route-id="@l.Id" class="d-inline" data-confirm="رفض طلب الإجازة؟">
                                    <button type="submit" class="btn btn-ghost btn-sm">رفض</button>
                                </form>
                                <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@l.Id">تعديل</a>
                            }
                            else if (l.Status == ApprovalStatus.Approved)
                            {
                                <form method="post" asp-action="Reject" asp-route-id="@l.Id" class="d-inline" data-confirm="رفض إجازة معتمدة؟ سيُعاد رصيد الإجازة السنوية.">
                                    <button type="submit" class="btn btn-ghost btn-sm">إلغاء الاعتماد</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
