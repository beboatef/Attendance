@model EmployeeIndexViewModel
@{ ViewData["Title"] = "الموظفون"; }
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">بحث (الاسم / الكود)</label>
                <input type="text" name="search" value="@Model.Search" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">القسم</label>
                <select name="department" class="form-select">
                    <option value="">الكل</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d" selected="@(d == Model.DepartmentFilter)">@d</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="isActive" class="form-select">
                    <option value="">الكل</option>
                    <option value="true" selected="@(Model.IsActive == true)">نشط</option>
                    <option value="false" selected="@(Model.IsActive == false)">معطّل</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary">بحث</button>
                <a class="btn btn-success" asp-action="Create">إضافة موظف</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">قائمة الموظفين (@Model.TotalCount)</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>الكود</th><th>كود الجهاز</th><th>الاسم</th><th>المسمى</th><th>القسم</th>
                <th>الوردية</th><th>الراتب</th><th>التعيين</th><th>الحالة</th><th>إجراءات</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Employees.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-4">لا توجد بيانات</td></tr>
            }
            @foreach (var e in Model.Employees)
            {
                <tr>
                    <td>@e.EmployeeCode</td>
                    <td>@e.DeviceEmployeeCode</td>
                    <td>@e.FullName</td>
                    <td>@e.JobTitle</td>
                    <td>@e.Department</td>
                    <td>@e.Shift?.ShiftName</td>
                    <td>@e.BasicSalary.ToString("#,##0.00")</td>
                    <td>@e.HireDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (e.IsActive) { <span class="badge bg-success">نشط</span> }
                        else { <span class="badge bg-secondary">معطّل</span> }
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">تعديل</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.Id">تفاصيل</a>
                        <form asp-action="ToggleActive" asp-route-id="@e.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-warning" type="submit">@(e.IsActive ? "تعطيل" : "تفعيل")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
