@using HrPayroll.Domain.Entities
@model HrPayroll.Web.ViewModels.EmployeeImportPreviewViewModel
@{
    ViewData["Title"] = "استيراد الموظفين من Excel";
    var batches = ViewBag.Batches as List<ImportBatch> ?? new List<ImportBatch>();
}
<div class="card">
    <div class="card-head">
        <div>
            <h2>استيراد قائمة الموظفين والرواتب</h2>
            <div class="sub">ارفع الملف ← عاين وتحقق ← أكّد الاستيراد. لا يتم استبدال بيانات أي موظف موجود بدون اختيارك الصريح.</div>
        </div>
        <a class="btn btn-soft btn-sm" asp-action="DownloadTemplate">تنزيل قالب Excel</a>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Import" enctype="multipart/form-data">
            <div class="form-grid">
                <div class="field span-2">
                    <label>ملف Excel (xlsx / xls / csv) — الحد الأقصى 25 ميجابايت</label>
                    <input type="file" name="file" accept=".xlsx,.xls,.csv,.xml" required />
                </div>
            </div>
            <div class="alert alert-info" style="margin-top:14px">
                <span>
                    الأعمدة المدعومة: كود الموظف، كود البصمة، الاسم، القسم، المسمى الوظيفي، الراتب الأساسي،
                    الأجر اليومي، تاريخ التعيين، الهاتف، البريد، الرقم القومي، ساعات العمل، استحقاق الإجازة، ملاحظات.
                    يمكن للبرنامج التعرف على العناوين بالعربية أو الإنجليزية.
                </span>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn btn-primary btn-lg">تحليل الملف وعرض المعاينة</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-head"><h3>سجل عمليات استيراد الموظفين</h3></div>
    @if (batches.Count == 0)
    {
        ViewData["message"] = "لم يتم استيراد أي ملف موظفين بعد";
        ViewData["icon"] = "📥";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr><th>الملف</th><th>التاريخ</th><th>المستخدم</th><th>إجمالي الصفوف</th><th>جديد</th><th>محدَّث</th><th>مكرر</th><th>متجاهَل/غير صالح</th><th>الملخص</th></tr>
                </thead>
                <tbody>
                @foreach (var b in batches)
                {
                    <tr>
                        <td class="wrap">@b.FileName</td>
                        <td class="num">@b.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(b.ImportedByName ?? "-")</td>
                        <td class="num">@b.TotalRows</td>
                        <td class="num">@b.SuccessRows</td>
                        <td class="num">@b.UnknownEmployeeRows</td>
                        <td class="num">@b.DuplicateRows</td>
                        <td class="num">@b.InvalidRows</td>
                        <td class="wrap">@b.Notes</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
