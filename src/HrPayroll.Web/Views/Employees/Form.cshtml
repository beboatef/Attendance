@using HrPayroll.Domain.Enums
@model HrPayroll.Web.ViewModels.EmployeeFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "تعديل موظف" : "إضافة موظف";
}
<div class="card">
    <div class="card-head">
        <h2>@ViewData["Title"]</h2>
        <a class="btn btn-ghost btn-sm" asp-action="Index">رجوع للقائمة</a>
    </div>
    <div class="card-body">
        <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

            <div class="section-title">البيانات الأساسية</div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="EmployeeCode">كود الموظف</label>
                    <input asp-for="EmployeeCode" />
                    <span asp-validation-for="EmployeeCode" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="DeviceEmployeeCode">كود البصمة / الجهاز</label>
                    <input asp-for="DeviceEmployeeCode" placeholder="اتركه فارغًا لاستخدام كود الموظف" />
                    <span class="hint">قد يختلف عن كود الموظف الداخلي. المطابقة في الاستيراد تتم بهذا الكود أولًا.</span>
                    <span asp-validation-for="DeviceEmployeeCode" class="field-error"></span>
                </div>
                <div class="field span-2">
                    <label asp-for="FullName">الاسم الكامل</label>
                    <input asp-for="FullName" />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="DepartmentId">القسم</label>
                    <select asp-for="DepartmentId" asp-items="Model.DepartmentList">
                        <option value="">— بدون —</option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="JobTitleId">المسمى الوظيفي</label>
                    <select asp-for="JobTitleId" asp-items="Model.JobTitleList">
                        <option value="">— بدون —</option>
                    </select>
                </div>
            </div>

            <div class="section-title">الأجر وساعات العمل</div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="BasicSalary">الراتب الأساسي الشهري</label>
                    <input asp-for="BasicSalary" type="number" step="0.01" min="0" />
                    <span asp-validation-for="BasicSalary" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="DailyRate">الأجر اليومي (اختياري)</label>
                    <input asp-for="DailyRate" type="number" step="0.01" min="0" />
                    <span class="hint">إن تُرك فارغًا: الأجر اليومي = الراتب ÷ عدد أيام الشهر (30 حسب الإعدادات).</span>
                </div>
                <div class="field">
                    <label asp-for="StandardWorkHours">ساعات العمل القياسية يوميًا</label>
                    <input asp-for="StandardWorkHours" type="number" step="0.5" min="0.5" max="24" />
                    <span asp-validation-for="StandardWorkHours" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="HireDate">تاريخ التعيين</label>
                    <input asp-for="HireDate" type="date" />
                    <span asp-validation-for="HireDate" class="field-error"></span>
                </div>
            </div>

            <div class="section-title">الإجازات والحالة الوظيفية</div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="AnnualLeaveEntitlement">استحقاق الإجازة السنوية (يوم)</label>
                    <input asp-for="AnnualLeaveEntitlement" type="number" step="0.5" min="0" />
                </div>
                <div class="field">
                    <label asp-for="AnnualLeaveBalance">الرصيد المتبقي</label>
                    <input asp-for="AnnualLeaveBalance" type="number" step="0.5" min="0" />
                </div>
                <div class="field">
                    <label asp-for="EmploymentStatus">الحالة الوظيفية</label>
                    <select asp-for="EmploymentStatus" asp-items="Model.EmploymentStatusList"></select>
                    <span class="hint">الموظف غير "على العمل" لا يُدرج في كشوف الرواتب الجديدة.</span>
                </div>
                <div class="field">
                    <label asp-for="TerminationDate">تاريخ انتهاء الخدمة</label>
                    <input asp-for="TerminationDate" type="date" />
                </div>
                <div class="field">
                    <label asp-for="ShiftId">الوردية الأساسية</label>
                    <select asp-for="ShiftId" asp-items="Model.ShiftList">
                        <option value="">— بدون وردية ثابتة —</option>
                    </select>
                    <span class="hint">اختيارية: النظام يكتشف الوردية الفعلية من البصمات إذا لم تُحدد.</span>
                </div>
            </div>

            <div class="section-title">بيانات التواصل</div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Phone">الهاتف</label>
                    <input asp-for="Phone" />
                </div>
                <div class="field">
                    <label asp-for="Email">البريد الإلكتروني</label>
                    <input asp-for="Email" type="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="NationalId">الرقم القومي</label>
                    <input asp-for="NationalId" />
                </div>
                <div class="field span-2">
                    <label asp-for="Notes">ملاحظات</label>
                    <textarea asp-for="Notes" rows="2"></textarea>
                </div>
            </div>

            <div class="btn-row" style="margin-top:20px">
                <button type="submit" class="btn btn-primary btn-lg">@(isEdit ? "حفظ التعديلات" : "إضافة الموظف")</button>
                <a class="btn btn-ghost btn-lg" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
