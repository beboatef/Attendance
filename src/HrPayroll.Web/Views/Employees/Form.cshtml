@model EmployeeFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "إضافة موظف" : "تعديل موظف"; }
<div class="card">
    <div class="card-body">
        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-4">
                <label asp-for="EmployeeCode" class="form-label"></label>
                <input asp-for="EmployeeCode" class="form-control" />
                <span asp-validation-for="EmployeeCode" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="DeviceEmployeeCode" class="form-label"></label>
                <input asp-for="DeviceEmployeeCode" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="JobTitle" class="form-label"></label>
                <input asp-for="JobTitle" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Department" class="form-label"></label>
                <input asp-for="Department" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="ShiftId" class="form-label"></label>
                <select asp-for="ShiftId" class="form-select">
                    <option value="">-- بدون وردية --</option>
                    @foreach (var s in Model.Shifts)
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.ShiftId)">@s.ShiftName (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="BasicSalary" class="form-label"></label>
                <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="BasicSalary" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="HireDate" class="form-label"></label>
                <input asp-for="HireDate" class="form-control" type="date" />
                <span asp-validation-for="HireDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="NationalId" class="form-label"></label>
                <input asp-for="NationalId" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">حفظ</button>
                <a class="btn btn-secondary" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
