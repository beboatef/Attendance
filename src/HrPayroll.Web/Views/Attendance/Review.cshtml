@model DailyAttendance
@{
    ViewData["Title"] = "مراجعة سجل الحضور";
    var events = ViewBag.Events as List<AttendanceEvent> ?? new List<AttendanceEvent>();
}
<div class="card mb-3">
    <div class="card-header fw-bold">@Model.Employee?.FullName — @Model.WorkDate.ToString("yyyy-MM-dd")</div>
    <div class="card-body row">
        <div class="col-md-3"><strong>الوردية:</strong> @Model.Shift?.ShiftName</div>
        <div class="col-md-3"><strong>بداية الوردية:</strong> @Model.ShiftStart.ToString("yyyy-MM-dd HH:mm")</div>
        <div class="col-md-3"><strong>نهاية الوردية:</strong> @Model.ShiftEnd.ToString("yyyy-MM-dd HH:mm")</div>
        <div class="col-md-3"><strong>الحالة الحالية:</strong> @Model.Status</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">البصمات المسجلة لهذا اليوم</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>الوقت</th><th>النوع</th><th>رقم الجهاز</th><th>حالة التصنيف</th><th>المصدر</th><th>ملاحظة</th></tr></thead>
            <tbody>
            @foreach (var e in events)
            {
                <tr>
                    <td>@e.EventTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@e.EventType</td>
                    <td>@e.RawPunch?.DeviceId</td>
                    <td>@e.ClassificationStatus</td>
                    <td>@e.ClassificationSource</td>
                    <td>@e.Notes</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">المراجعة اليدوية</div>
    <div class="card-body">
        <form asp-action="Review" asp-route-id="@Model.Id" method="post" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">وقت الدخول</label>
                <input type="datetime-local" name="checkIn" value="@(Model.CheckInTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">وقت الخروج</label>
                <input type="datetime-local" name="checkOut" value="@(Model.CheckOutTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">حالة الحضور</label>
                <select name="status" class="form-select">
                    @foreach (var s in Enum.GetValues<AttendanceStatus>())
                    {
                        <option value="@((int)s)" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">ملاحظات المسؤول</label>
                <input type="text" name="adminNotes" value="@Model.AdminNotes" class="form-control" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary">حفظ المراجعة</button>
                <a class="btn btn-secondary" asp-action="Index">رجوع</a>
            </div>
        </form>
    </div>
</div>
