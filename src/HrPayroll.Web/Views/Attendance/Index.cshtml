@model List<DailyAttendance>
@{
    ViewData["Title"] = "الحضور اليومي";
    string StatusBadge(AttendanceStatus s) => s switch
    {
        AttendanceStatus.Present => "bg-success",
        AttendanceStatus.Late => "bg-warning text-dark",
        AttendanceStatus.Absent => "bg-danger",
        AttendanceStatus.Leave => "bg-info text-dark",
        AttendanceStatus.RestDay => "bg-secondary",
        AttendanceStatus.MissingCheckIn => "bg-dark",
        AttendanceStatus.MissingCheckOut => "bg-dark",
        _ => "bg-warning text-dark"
    };
    string StatusText(AttendanceStatus s) => s switch
    {
        AttendanceStatus.Present => "حاضر",
        AttendanceStatus.Late => "متأخر",
        AttendanceStatus.Absent => "غائب",
        AttendanceStatus.Leave => "إجازة",
        AttendanceStatus.RestDay => "يوم راحة",
        AttendanceStatus.MissingCheckIn => "بصمة دخول مفقودة",
        AttendanceStatus.MissingCheckOut => "بصمة خروج مفقودة",
        _ => "يحتاج مراجعة"
    };
}
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2"><label class="form-label">من</label><input type="date" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label">إلى</label><input type="date" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">الموظف</label><select name="employeeId" asp-items="ViewBag.Employees" class="form-select"><option value="">الكل</option></select></div>
            <div class="col-md-2"><label class="form-label">الوردية</label><select name="shiftId" asp-items="ViewBag.Shifts" class="form-select"><option value="">الكل</option></select></div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary">عرض</button>
                <a class="btn btn-outline-secondary" asp-action="Exceptions">الاستثناءات</a>
            </div>
        </form>
        <hr />
        <form asp-action="Process" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="employeeId" value="@ViewBag.EmployeeId" />
            <div class="col-md-9">
                <label class="form-label mb-1">معالجة البصمات وتصنيفها إلى حضور يومي</label>
                <div class="form-text">يعيد بناء حركات الدخول/الخروج وملخص الحضور للفترة المحددة.</div>
            </div>
            <div class="col-md-3"><button class="btn btn-success w-100">معالجة الفترة</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-sm mb-0">
            <thead>
            <tr>
                <th>الكود</th><th>الاسم</th><th>التاريخ</th><th>الوردية</th><th>دخول</th><th>خروج</th>
                <th>تأخير (د)</th><th>إضافي محسوب</th><th>إضافي معتمد</th><th>الحالة</th><th>المراجعة</th><th>ملاحظات</th><th></th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="13" class="text-center text-muted py-4">لا توجد بيانات. اضغط "معالجة الفترة" بعد استيراد البصمات.</td></tr>
            }
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Employee?.EmployeeCode</td>
                    <td>@d.Employee?.FullName</td>
                    <td>@d.WorkDate.ToString("yyyy-MM-dd")</td>
                    <td>@d.Shift?.ShiftName</td>
                    <td>@(d.CheckInTime?.ToString("HH:mm"))</td>
                    <td>@(d.CheckOutTime?.ToString("HH:mm"))</td>
                    <td>@d.LateMinutes</td>
                    <td>@Math.Round(d.CalculatedOvertimeMinutes / 60m, 2)</td>
                    <td>@Math.Round(d.ApprovedOvertimeMinutes / 60m, 2)</td>
                    <td><span class="badge @StatusBadge(d.Status)">@StatusText(d.Status)</span></td>
                    <td>
                        @if (d.PunchReviewStatus == ClassificationStatus.NeedsReview)
                        { <span class="badge bg-warning text-dark">مراجعة</span> }
                        else { <span class="badge bg-success">مصنف</span> }
                    </td>
                    <td>@(d.AdminNotes ?? d.Notes)</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-action="Review" asp-route-id="@d.Id">مراجعة</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
