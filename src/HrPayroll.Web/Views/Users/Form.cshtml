@model CreateUserViewModel
@{
    ViewData["Title"] = "إضافة مستخدم";
}
<div class="card">
    <div class="card-head">
        <div>
            <h2>إضافة مستخدم جديد</h2>
            <div class="sub">كلمة المرور يجب أن تكون 8 أحرف على الأقل وتحتوي حرفًا كبيرًا وحرفًا صغيرًا ورقمًا.</div>
        </div>
        <a class="btn btn-ghost btn-sm" asp-action="Index">رجوع للقائمة</a>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                 style="display:@(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

            <div class="form-grid">
                <div class="field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" dir="ltr" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" dir="ltr" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Role"></label>
                    <select asp-for="Role" asp-items="ViewBag.RoleList"></select>
                    <span class="hint">
                        Admin: كل الصلاحيات · HR: الموظفون والحضور والإجازات · Accountant: المرتبات والسلف ·
                        Viewer: عرض التقارير فقط.
                    </span>
                </div>
                <div class="field">
                    <label class="switch">
                        <input asp-for="IsActive" />
                        <span>نشط (يستطيع تسجيل الدخول)</span>
                    </label>
                </div>
            </div>

            <div class="btn-row" style="margin-top:20px">
                <button type="submit" class="btn btn-primary btn-lg">إنشاء المستخدم</button>
                <a class="btn btn-ghost btn-lg" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
