@using HrPayroll.Domain.Entities
@model List<Department>
@{
    ViewData["Title"] = "الأقسام";
    ViewData["Subtitle"] = "الأقسام والمسميات وأعداد الموظفين";
    var counts = ViewBag.EmployeeCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var jobCounts = ViewBag.JobTitleCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<div class="card">
    <div class="card-head">
        <h2>الأقسام</h2>
        <a class="btn btn-primary btn-sm" asp-action="Create">+ إضافة قسم</a>
    </div>
    <div class="card-body">
        <form method="get" class="filters">
            <div class="field">
                <label>بحث</label>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="اسم أو كود القسم" />
            </div>
            <div class="field">
                <label>الحالة</label>
                <select name="isActive">
                    <option value="">الكل</option>
                    <option value="true">نشط</option>
                    <option value="false">معطّل</option>
                </select>
            </div>
            <div class="field actions">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a class="btn btn-ghost" asp-action="Index">مسح</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h3>القائمة (@Model.Count)</h3>
        <input type="text" data-table-filter="#deptTable" placeholder="بحث فوري..." style="max-width:260px" />
    </div>
    @if (Model.Count == 0)
    {
        ViewData["message"] = "لا توجد أقسام";
        ViewData["hint"] = "أضف الأقسام لتظهر في قائمة اختيار القسم عند إضافة الموظفين.";
        ViewData["actionUrl"] = Url.Action("Create");
        ViewData["actionText"] = "إضافة قسم";
        ViewData["icon"] = "🏢";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data" id="deptTable">
                <thead>
                <tr><th>الاسم</th><th>الكود</th><th>المدير</th><th>عدد الموظفين</th><th>عدد المسميات</th><th>الحالة</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Name</td>
                        <td class="num">@(d.Code ?? "-")</td>
                        <td>@(d.ManagerName ?? "-")</td>
                        <td class="num">@(counts.TryGetValue(d.Id, out var c) ? c : 0)</td>
                        <td class="num">@(jobCounts.TryGetValue(d.Id, out var j) ? j : 0)</td>
                        <td>@if (d.IsActive) { <span class="badge ok">نشط</span> } else { <span class="badge muted">معطّل</span> }</td>
                        <td class="btn-row">
                            <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@d.Id">تعديل</a>
                            <form method="post" asp-action="ToggleActive" asp-route-id="@d.Id" class="d-inline" data-confirm="تغيير حالة القسم؟">
                                <button type="submit" class="btn btn-ghost btn-sm">@(d.IsActive ? "تعطيل" : "تفعيل")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
