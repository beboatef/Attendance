@model List<Deduction>
@using HrPayroll.Domain.Enums
@{
    ViewData["Title"] = "الخصومات والجزاءات";
    var totalApproved = Model.Where(d => d.Status == ApprovalStatus.Approved).Sum(d => d.Amount);
    ViewData["Subtitle"] = "الخصومات والجزاءات المعتمدة";
}
<div class="page-hero">
    <div class="page-hero-ico" aria-hidden="true">−</div>
    <div class="page-hero-body">
        <h2>الخصومات والجزاءات</h2>
        <div class="sub">إجمالي المعتمد: @totalApproved.ToString("N2") — يُقتطع مرة واحدة في الشهر المحدد</div>
    </div>
</div>
<div class="card">
    <div class="card-head">
        <div>
            <h2>الخصومات والجزاءات</h2>
            <div class="sub">
                الخصم المعتمد يُقتطع من صافي الراتب في الشهر المحدد مرة واحدة فقط، ولا يتكرر عند إعادة احتساب الكشف.
            </div>
        </div>
        <a class="btn btn-primary btn-sm" asp-action="Create">+ تسجيل خصم</a>
    </div>
    @if (Model.Count == 0)
    {
        ViewData["message"] = "لا توجد خصومات مسجَّلة";
        ViewData["hint"] = "سجّل خصمًا لموظف ثم اعتمده ليُخصم من كشف راتبه.";
        ViewData["icon"] = "➖";
        <partial name="_Empty" />
    }
    else
    {
        <div class="stat-grid" style="padding:16px 16px 0">
            <div class="stat"><div class="label">عدد الخصومات</div><div class="value">@Model.Count</div></div>
            <div class="stat bad"><div class="label">إجمالي الخصومات المعتمدة</div><div class="value">@totalApproved.ToString("N2")</div></div>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr>
                    <th>الموظف</th><th>التاريخ</th><th>المبلغ</th><th>السبب</th><th>الشهر</th>
                    <th>الحالة</th><th>مطبّق؟</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var d in Model)
                {
                    var cls = d.Status switch
                    {
                        ApprovalStatus.Approved => "ok",
                        ApprovalStatus.Rejected => "bad",
                        _ => "warn"
                    };
                    var statusText = d.Status switch
                    {
                        ApprovalStatus.Approved => "معتمد",
                        ApprovalStatus.Rejected => "مرفوض",
                        _ => "قيد المراجعة"
                    };
                    <tr>
                        <td>@d.Employee?.FullName <span class="hint">@d.Employee?.EmployeeCode</span></td>
                        <td class="num">@d.DeductionDate.ToString("yyyy-MM-dd")</td>
                        <td class="num money">@d.Amount.ToString("N2")</td>
                        <td class="wrap">@d.Reason</td>
                        <td class="num">@d.Year-@d.Month.ToString("00")</td>
                        <td><span class="badge @cls">@statusText</span></td>
                        <td>@(d.PayrollItemId.HasValue ? "نعم" : "لا")</td>
                        <td class="btn-row">
                            <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@d.Id">تعديل</a>
                            <form method="post" asp-action="Approve" asp-route-id="@d.Id"
                                  data-confirm="تغيير حالة اعتماد الخصم؟ سيؤثر ذلك على صافي الراتب.">
                                <button type="submit" class="btn btn-ghost btn-sm">اعتماد/إلغاء</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
