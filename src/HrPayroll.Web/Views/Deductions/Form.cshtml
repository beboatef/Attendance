@model Deduction
@{ ViewData["Title"] = Model.Id == 0 ? "تسجيل خصم" : "تعديل خصم"; }
<div class="card">
    <div class="card-body">
        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-4">
                <label class="form-label">الموظف</label>
                <select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-select"><option value="">اختر</option></select>
            </div>
            <div class="col-md-4"><label class="form-label">المبلغ</label><input asp-for="Amount" type="number" step="0.01" class="form-control" /><span asp-validation-for="Amount" class="text-danger"></span></div>
            <div class="col-md-4"><label class="form-label">تاريخ الخصم</label><input asp-for="DeductionDate" type="date" class="form-control" /></div>
            <div class="col-md-8"><label class="form-label">السبب</label><input asp-for="Reason" class="form-control" /><span asp-validation-for="Reason" class="text-danger"></span></div>
            <div class="col-md-2"><label class="form-label">الشهر</label><input asp-for="Month" type="number" min="1" max="12" class="form-control" /><span asp-validation-for="Month" class="text-danger"></span></div>
            <div class="col-md-2"><label class="form-label">السنة</label><input asp-for="Year" type="number" class="form-control" /></div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary">حفظ</button>
                <a class="btn btn-secondary" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
