@using HrPayroll.Domain.Entities
@{
    ViewData["Title"] = "استيراد البصمات";
    var batches = ViewBag.Batches as List<ImportBatch> ?? new List<ImportBatch>();
}
<div class="card">
    <div class="card-head">
        <div>
            <h2>استيراد ملف بصمات جهاز الحضور</h2>
            <div class="sub">ارفع الملف ← عاين وتحقق ← أكّد. التكرار محمي على مستوى البصمة الواحدة.</div>
        </div>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Upload" enctype="multipart/form-data">
            <div class="form-grid">
                <div class="field span-2">
                    <label>ملف البصمات (xlsx / xls / csv / Excel 2003 XML) — الحد الأقصى 25 ميجابايت</label>
                    <input type="file" name="file" accept=".xlsx,.xls,.csv,.xml,.txt" required />
                </div>
            </div>
            <div class="alert alert-info" style="margin-top:14px">
                <span>
                    يدعم النظام ملفات البصمة المصدّرة من جهاز البصمة: ملف دخول فقط، أو خروج فقط، أو ملف واحد بكل الحركات.
                    المطابقة تتم بكود الجهاز/البصمة لا بالاسم. البصمات المكررة (نفس الموظف ونفس الوقت) لا تُستورد مرتين.
                </span>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn btn-primary btn-lg">تحليل الملف وعرض المعاينة</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-head"><h3>سجل عمليات الاستيراد</h3></div>
    @if (batches.Count == 0)
    {
        ViewData["message"] = "لم يتم استيراد أي ملف بصمات بعد";
        ViewData["icon"] = "📄";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr><th>الملف</th><th>الصيغة</th><th>التاريخ</th><th>المستخدم</th><th>إجمالي</th><th>ناجح</th><th>مكرر</th><th>غير صالح</th><th>موظف غير معروف</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var b in batches)
                {
                    <tr>
                        <td class="wrap">@b.FileName</td>
                        <td>@(b.DetectedFormat ?? "-")</td>
                        <td class="num">@b.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(b.ImportedByName ?? "-")</td>
                        <td class="num">@b.TotalRows</td>
                        <td class="num">@b.SuccessRows</td>
                        <td class="num">@b.DuplicateRows</td>
                        <td class="num">@b.InvalidRows</td>
                        <td class="num">@b.UnknownEmployeeRows</td>
                        <td><a class="btn btn-soft btn-sm" asp-action="Details" asp-route-id="@b.Id">عرض</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
