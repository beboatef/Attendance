@model Loan
@{ ViewData["Title"] = Model.Id == 0 ? "تسجيل سلفة" : "تعديل سلفة"; }
<div class="card">
    <div class="card-body">
        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-4">
                <label class="form-label">الموظف</label>
                <select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-select"><option value="">اختر</option></select>
            </div>
            <div class="col-md-4"><label class="form-label">المبلغ</label><input asp-for="Amount" type="number" step="0.01" class="form-control" /><span asp-validation-for="Amount" class="text-danger"></span></div>
            <div class="col-md-4"><label class="form-label">تاريخ السلفة</label><input asp-for="LoanDate" type="date" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">شهر الخصم</label><input asp-for="DeductionMonth" type="number" min="1" max="12" class="form-control" /><span asp-validation-for="DeductionMonth" class="text-danger"></span></div>
            <div class="col-md-3"><label class="form-label">سنة الخصم</label><input asp-for="DeductionYear" type="number" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">عدد الأقساط</label><input asp-for="Installments" type="number" class="form-control" /><span asp-validation-for="Installments" class="text-danger"></span></div>
            <div class="col-12"><label class="form-label">ملاحظات</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary">حفظ</button>
                <a class="btn btn-secondary" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
