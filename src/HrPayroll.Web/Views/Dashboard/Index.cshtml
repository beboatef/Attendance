@using HrPayroll.Domain.Enums
@model HrPayroll.Infrastructure.Services.DashboardData
@using HrPayroll.Infrastructure.Services
@{
    ViewData["Title"] = "لوحة التحكم";
    ViewData["Subtitle"] = "نظرة شاملة على الحضور والرواتب من البيانات الفعلية";
    var currency = ViewBag.Currency as string ?? "EGP";
    var months = new[] { "يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر" };
    var dayStr = Model.StatDate.ToString("yyyy-MM-dd");

    string nsTitle, nsDesc, nsUrl, nsBtn, nsIcon, nsTone;
    if (Model.ActiveEmployees == 0)
    {
        nsIcon = "◍"; nsTone = "warn";
        nsTitle = "ابدأ بإضافة الموظفين";
        nsDesc = "لا يوجد موظفون نشطون بعد. أضف الموظفين يدويًا أو استوردهم من ملف Excel قبل تسجيل الحضور.";
        nsUrl = Url.Action("Import", "Employees")!; nsBtn = "استيراد الموظفين من Excel";
    }
    else if (Model.LatestImports.Count == 0)
    {
        nsIcon = "▤"; nsTone = "info";
        nsTitle = "استورد ملفات بصمات الحضور";
        nsDesc = "تم تسجيل الموظفين، لكن لم يُستورد أي ملف بصمات بعد. ابدأ باستيراد ملفي الدخول والخروج لهذا الشهر.";
        nsUrl = Url.Action("Index", "Import")!; nsBtn = "استيراد البصمات";
    }
    else if (Model.DaysWithoutData > 0)
    {
        nsIcon = "◔"; nsTone = "warn";
        nsTitle = "عالج حضور اليوم";
        nsDesc = $"يوجد {Model.ActiveEmployees} موظفًا نشطًا بلا بيانات حضور مسجّلة لهذا اليوم. تأكد من استيراد بصمات اليوم ثم عالج الحضور.";
        nsUrl = Url.Action("Index", "Attendance")!; nsBtn = "معالجة الحضور";
    }
    else if (Model.NeedsReview > 0 || Model.MissingPunches > 0)
    {
        nsIcon = "؟"; nsTone = "bad";
        nsTitle = "راجع الاستثناءات والبصمات الناقصة";
        nsDesc = $"يوجد {Model.NeedsReview} سجلًا يحتاج مراجعة و{Model.MissingPunches} بصمة ناقصة. عالجها قبل احتساب الرواتب.";
        nsUrl = Url.Action("Exceptions", "Attendance")!; nsBtn = "مراجعة الاستثناءات";
    }
    else if (Model.PendingOvertimeApprovals > 0)
    {
        nsIcon = "◷"; nsTone = "warn";
        nsTitle = "اعتمد ساعات الإضافي";
        nsDesc = $"يوجد {Model.PendingOvertimeApprovals} يومًا بإضافي خام بانتظار الاعتماد. الإضافي غير المعتمد لا يُضاف إلى الراتب.";
        nsUrl = Url.Action("Index", "Overtime")!; nsBtn = "اعتماد الإضافي";
    }
    else if (Model.PayrollItemCount == 0)
    {
        nsIcon = "⬣"; nsTone = "info";
        nsTitle = "احتسب كشف المرتبات";
        nsDesc = "بيانات الحضور جاهزة. انتقل إلى كشف المرتبات الشهري ثم اضغط «تحديث الحسابات» لإنشاء الكشف.";
        nsUrl = Url.Action("Index", "Payroll", new { month = Model.Month, year = Model.Year })!; nsBtn = "فتح كشف المرتبات";
    }
    else
    {
        nsIcon = "✔"; nsTone = "ok";
        nsTitle = "الكشف جاهز للمراجعة";
        nsDesc = "تم احتساب كشف هذا الشهر. راجع الأسطر والتعديلات اليدوية ثم اعتمد الكشف أو اطبعه.";
        nsUrl = Url.Action("Index", "Payroll", new { month = Model.Month, year = Model.Year })!; nsBtn = "مراجعة كشف المرتبات";
    }
}

<div class="dash-hero">
    <div class="dash-hero-body">
        <h2>ملخص اليوم @dayStr</h2>
        <div class="sub">@Model.ActiveEmployees موظف نشط · @Model.Present حاضر · @Model.Absent غائب · @Model.Late متأخر — كل الأرقام من البيانات الفعلية.</div>
    </div>
    <form method="get" class="dash-hero-form">
        <input type="date" name="date" value="@dayStr" aria-label="تاريخ الملخص" />
        <select name="month" aria-label="الشهر">
            @for (var m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == Model.Month)">@months[m - 1]</option>
            }
        </select>
        <input type="number" name="year" value="@Model.Year" style="width:90px" aria-label="السنة" />
        <button type="submit" class="btn">عرض</button>
    </form>
</div>

<div class="next-step @nsTone">
    <div class="next-step-ico" aria-hidden="true">@nsIcon</div>
    <div class="next-step-body">
        <div class="next-step-k">الخطوة التالية</div>
        <h3>@nsTitle</h3>
        <p>@nsDesc</p>
    </div>
    <a class="btn btn-primary next-step-btn" href="@nsUrl">@nsBtn</a>
</div>

<div class="stat-grid">
    <a class="stat" asp-controller="Employees" asp-action="Index">
        <span class="stat-ico">◍</span>
        <span class="stat-main"><span class="label">الموظفون النشطون</span><span class="value">@Model.ActiveEmployees</span><span class="hint">موظف على العمل</span></span>
    </a>
    <a class="stat ok" asp-controller="Attendance" asp-action="Index" asp-route-from="@dayStr" asp-route-to="@dayStr">
        <span class="stat-ico">✔</span>
        <span class="stat-main"><span class="label">حاضرون اليوم</span><span class="value">@Model.Present</span><span class="hint">تم تسجيل بصمة دخول</span></span>
    </a>
    <a class="stat bad" asp-controller="Attendance" asp-action="Index" asp-route-from="@dayStr" asp-route-to="@dayStr">
        <span class="stat-ico">✕</span>
        <span class="stat-main"><span class="label">غائبون اليوم</span><span class="value">@Model.Absent</span><span class="hint">بعد معالجة الحضور</span></span>
    </a>
    <a class="stat warn" asp-controller="Attendance" asp-action="Index" asp-route-from="@dayStr" asp-route-to="@dayStr">
        <span class="stat-ico">◷</span>
        <span class="stat-main"><span class="label">متأخرون</span><span class="value">@Model.Late</span><span class="hint">تجاوزوا فترة السماح</span></span>
    </a>
    <a class="stat bad" asp-controller="Attendance" asp-action="Exceptions">
        <span class="stat-ico">؟</span>
        <span class="stat-main"><span class="label">بصمات ناقصة</span><span class="value">@Model.MissingPunches</span><span class="hint">دخول @Model.MissingEntry / خروج @Model.MissingExit</span></span>
    </a>
    <a class="stat warn" asp-controller="Attendance" asp-action="Exceptions">
        <span class="stat-ico">◌</span>
        <span class="stat-main"><span class="label">يحتاج مراجعة</span><span class="value">@Model.NeedsReview</span><span class="hint">وردية غامضة: @Model.AmbiguousShifts</span></span>
    </a>
    <div class="stat">
        <span class="stat-ico">☾</span>
        <span class="stat-main"><span class="label">إجازات اليوم</span><span class="value">@Model.OnLeave</span><span class="hint">مدفوعة وغير مدفوعة</span></span>
    </div>
    <div class="stat">
        <span class="stat-ico">▦</span>
        <span class="stat-main"><span class="label">راحة/عطلة</span><span class="value">@Model.RestOrHoliday</span><span class="hint">جمعة أو عطلة رسمية</span></span>
    </div>
</div>

<div class="stat-grid">
    <a class="stat warn" asp-controller="Overtime" asp-action="Index">
        <span class="stat-ico">◷</span>
        <span class="stat-main"><span class="label">إضافي بانتظار الاعتماد</span><span class="value">@Model.PendingOvertimeApprovals</span><span class="hint">أيام بها إضافي خام غير معتمد</span></span>
    </a>
    <div class="stat">
        <span class="stat-ico">◔</span>
        <span class="stat-main"><span class="label">إضافي الشهر (خام)</span><span class="value">@Model.OvertimeHoursMonth <small>ساعة</small></span><span class="hint">معتمد: @Model.ApprovedOvertimeHoursMonth ساعة</span></span>
    </div>
    <div class="stat bad">
        <span class="stat-ico">−</span>
        <span class="stat-main"><span class="label">خصومات الشهر</span><span class="value">@Model.TotalDeductions.ToString("N2")</span><span class="hint">خصومات معتمدة + سلف @Model.TotalLoans.ToString("N2")</span></span>
    </div>
    <a class="stat ok" asp-controller="Payroll" asp-action="Index" asp-route-month="@Model.Month" asp-route-year="@Model.Year">
        <span class="stat-ico">⬣</span>
        <span class="stat-main"><span class="label">صافي كشف الشهر</span><span class="value">@Model.TotalNetPayroll.ToString("N2") <small>@currency</small></span><span class="hint">
            @if (Model.PayrollItemCount > 0)
            {
                <span>@Model.PayrollItemCount موظف — إجمالي @Model.TotalGrossPayroll.ToString("N2") — الحالة:</span>
                <span class="badge info">@ExcelExportService.PayrollStatusText((PayrollStatus)Model.PayrollStatus)</span>
            }
            else
            {
                <span>لم يُحتسب كشف لهذا الشهر بعد</span>
            }
        </span></span>
    </a>
</div>

<div class="card">
    <div class="card-head"><h3>إجراءات سريعة</h3></div>
    <div class="card-body">
        <div class="qa-grid">
            <a class="qa" asp-controller="Import" asp-action="Index"><span class="qa-ico">⇩</span> استيراد البصمات</a>
            <a class="qa" asp-controller="Attendance" asp-action="Index"><span class="qa-ico">◔</span> الحضور اليومي</a>
            <a class="qa" asp-controller="Reports" asp-action="Departments"><span class="qa-ico">▤</span> تقارير الأقسام</a>
            <a class="qa" asp-controller="Employees" asp-action="Index"><span class="qa-ico">◍</span> الموظفون</a>
            <a class="qa" asp-controller="Payroll" asp-action="Index"><span class="qa-ico">⬣</span> المرتبات</a>
            <a class="qa" asp-controller="Overtime" asp-action="Index"><span class="qa-ico">◷</span> اعتماد الإضافي</a>
            <a class="qa" asp-controller="Leaves" asp-action="Index"><span class="qa-ico">☾</span> الإجازات</a>
        </div>
    </div>
</div>

<div class="panel-grid">
<div class="card">
    <div class="card-head">
        <h3>الحضور حسب القسم — @dayStr</h3>
        <a class="btn btn-soft btn-sm" asp-controller="Reports" asp-action="Daily" asp-route-from="@dayStr" asp-route-to="@dayStr">التقرير التفصيلي</a>
    </div>
    @if (Model.Departments.Count == 0)
    {
        ViewData["message"] = "لا يوجد موظفون مسجلون بعد. ابدأ بإضافة الموظفين أو استيرادهم من Excel.";
        ViewData["actionUrl"] = Url.Action("Import", "Employees");
        ViewData["actionText"] = "استيراد الموظفين من Excel";
        ViewData["icon"] = "◍";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap" style="margin:0">
            <table class="data">
                <thead>
                <tr>
                    <th>القسم</th><th>العدد</th><th>حضور</th><th>غياب</th><th>تأخير</th>
                    <th>إجازات</th><th>مراجعة</th><th>نسبة الحضور</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Departments)
                {
                    <tr>
                        <td>@d.Department</td>
                        <td class="num">@d.Total</td>
                        <td class="num">@d.Present</td>
                        <td class="num">@d.Absent</td>
                        <td class="num">@d.Late</td>
                        <td class="num">@d.OnLeave</td>
                        <td class="num">@d.NeedsReview</td>
                        <td style="min-width:120px">
                            <div class="bar"><span style="width:@(d.PresentRate)%"></span></div>
                            <span class="hint">@d.PresentRate%</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-head">
        <div>
            <h3>اتجاه صافي الرواتب — آخر 6 أشهر</h3>
            <div class="sub">من الكشوف غير الملغاة في قاعدة البيانات.</div>
        </div>
        <a class="btn btn-soft btn-sm" asp-controller="Reports" asp-action="Index">مركز التقارير</a>
    </div>
    @if (Model.PayrollTrend.Count == 0)
    {
        ViewData["message"] = "لا توجد كشوف رواتب بعد لعرض الاتجاه.";
        ViewData["hint"] = "احتسب كشف الشهر من صفحة المرتبات ليظهر هنا.";
        ViewData["icon"] = "⬣";
        <partial name="_Empty" />
    }
    else
    {
        var maxNet = Model.PayrollTrend.Max(p => p.TotalNet);
        if (maxNet <= 0) { maxNet = 1; }
        <div class="table-wrap" style="margin:0">
            <table class="data">
                <thead><tr><th>الفترة</th><th>الموظفون</th><th>صافي الكشف</th><th style="min-width:160px">الاتجاه</th></tr></thead>
                <tbody>
                @foreach (var p in Model.PayrollTrend)
                {
                    var pct = Math.Round(p.TotalNet * 100m / maxNet, 1);
                    <tr>
                        <td class="num"><a asp-controller="Payroll" asp-action="Index" asp-route-year="@p.Year" asp-route-month="@p.Month">@p.Label</a></td>
                        <td class="num">@p.ItemCount</td>
                        <td class="money">@p.TotalNet.ToString("N2")</td>
                        <td style="min-width:160px">
                            <div class="bar"><span style="width:@(pct)%"></span></div>
                            <span class="hint">@pct% من أعلى شهر</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
</div>

<div class="card">
    <div class="card-head">
        <h3>آخر عمليات استيراد البصمات</h3>
        <a class="btn btn-soft btn-sm" asp-controller="Import" asp-action="Index">استيراد ملف جديد</a>
    </div>
    @if (Model.LatestImports.Count == 0)
    {
        ViewData["message"] = "لم يتم استيراد أي ملف بصمات بعد.";
        ViewData["actionUrl"] = Url.Action("Index", "Import");
        ViewData["actionText"] = "استيراد ملف بصمات";
        ViewData["icon"] = "▤";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap" style="margin:0">
            <table class="data">
                <thead>
                <tr><th>الملف</th><th>تاريخ الاستيراد</th><th>المستخدم</th><th>إجمالي</th><th>ناجح</th><th>مكرر</th><th>غير صالح</th><th>موظف غير معروف</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var b in Model.LatestImports)
                {
                    <tr>
                        <td class="wrap">@b.FileName</td>
                        <td class="num">@b.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(b.ImportedByName ?? "-")</td>
                        <td class="num">@b.TotalRows</td>
                        <td class="num">@b.SuccessRows</td>
                        <td class="num">@b.DuplicateRows</td>
                        <td class="num">@b.InvalidRows</td>
                        <td class="num">@b.UnknownEmployeeRows</td>
                        <td><a class="btn btn-ghost btn-sm" asp-controller="Import" asp-action="Details" asp-route-id="@b.Id">عرض</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-head"><h3>المسار اليومي المعتاد</h3></div>
    <div class="card-body btn-row">
        <a class="btn btn-soft" asp-controller="Import" asp-action="Index">1) استيراد البصمات</a>
        <a class="btn btn-soft" asp-controller="Attendance" asp-action="Index">2) مراجعة الحضور</a>
        <a class="btn btn-soft" asp-controller="Overtime" asp-action="Index">3) اعتماد الإضافي</a>
        <a class="btn btn-soft" asp-controller="Reports" asp-action="Daily">4) التقرير اليومي</a>
        <a class="btn btn-soft" asp-controller="Payroll" asp-action="Index">5) احتساب الرواتب</a>
    </div>
</div>
