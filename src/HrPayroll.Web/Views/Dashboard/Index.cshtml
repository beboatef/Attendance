@using HrPayroll.Domain.Enums
@model HrPayroll.Infrastructure.Services.DashboardData
@using HrPayroll.Infrastructure.Services
@{
    ViewData["Title"] = "لوحة التحكم";
    var currency = ViewBag.Currency as string ?? "EGP";
    var months = new[] { "يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر" };

    // الخطوة التالية الموصى بها — محسوبة من بيانات قاعدة البيانات الفعلية بلا قيم ثابتة.
    string nsTitle, nsDesc, nsUrl, nsBtn, nsIcon, nsTone;
    if (Model.ActiveEmployees == 0)
    {
        nsIcon = "👥"; nsTone = "warn";
        nsTitle = "ابدأ بإضافة الموظفين";
        nsDesc = "لا يوجد موظفون نشطون بعد. أضف الموظفين يدويًا أو استوردهم من ملف Excel قبل تسجيل الحضور.";
        nsUrl = Url.Action("Import", "Employees")!; nsBtn = "استيراد الموظفين من Excel";
    }
    else if (Model.LatestImports.Count == 0)
    {
        nsIcon = "📄"; nsTone = "info";
        nsTitle = "استورد ملفات بصمات الحضور";
        nsDesc = "تم تسجيل الموظفين، لكن لم يُستورد أي ملف بصمات بعد. ابدأ باستيراد ملفي الدخول والخروج لهذا الشهر.";
        nsUrl = Url.Action("Index", "Import")!; nsBtn = "استيراد البصمات";
    }
    else if (Model.DaysWithoutData > 0)
    {
        nsIcon = "🕒"; nsTone = "warn";
        nsTitle = "عالج حضور اليوم";
        nsDesc = $"يوجد {Model.ActiveEmployees} موظفًا نشطًا بلا بيانات حضور مسجّلة لهذا اليوم. تأكد من استيراد بصمات اليوم ثم عالج الحضور.";
        nsUrl = Url.Action("Index", "Attendance")!; nsBtn = "معالجة الحضور";
    }
    else if (Model.NeedsReview > 0 || Model.MissingPunches > 0)
    {
        nsIcon = "🔍"; nsTone = "bad";
        nsTitle = "راجع الاستثناءات والبصمات الناقصة";
        nsDesc = $"يوجد {Model.NeedsReview} سجلًا يحتاج مراجعة و{Model.MissingPunches} بصمة ناقصة. عالجها قبل احتساب الرواتب.";
        nsUrl = Url.Action("Exceptions", "Attendance")!; nsBtn = "مراجعة الاستثناءات";
    }
    else if (Model.PendingOvertimeApprovals > 0)
    {
        nsIcon = "⏱️"; nsTone = "warn";
        nsTitle = "اعتمد ساعات الإضافي";
        nsDesc = $"يوجد {Model.PendingOvertimeApprovals} يومًا بإضافي خام بانتظار الاعتماد. الإضافي غير المعتمد لا يُضاف إلى الراتب.";
        nsUrl = Url.Action("Index", "Overtime")!; nsBtn = "اعتماد الإضافي";
    }
    else if (Model.PayrollItemCount == 0)
    {
        nsIcon = "💰"; nsTone = "info";
        nsTitle = "احتسب كشف المرتبات";
        nsDesc = "بيانات الحضور جاهزة. انتقل إلى كشف المرتبات الشهري ثم اضغط «تحديث الحسابات» لإنشاء الكشف.";
        nsUrl = Url.Action("Index", "Payroll", new { month = Model.Month, year = Model.Year })!; nsBtn = "فتح كشف المرتبات";
    }
    else
    {
        nsIcon = "✅"; nsTone = "ok";
        nsTitle = "الكشف جاهز للمراجعة";
        nsDesc = "تم احتساب كشف هذا الشهر. راجع الأسطر والتعديلات اليدوية ثم اعتمد الكشف أو اطبعه.";
        nsUrl = Url.Action("Index", "Payroll", new { month = Model.Month, year = Model.Year })!; nsBtn = "مراجعة كشف المرتبات";
    }
}

<div class="next-step @nsTone">
    <div class="next-step-ico" aria-hidden="true">@nsIcon</div>
    <div class="next-step-body">
        <div class="next-step-k">الخطوة التالية</div>
        <h3>@nsTitle</h3>
        <p>@nsDesc</p>
    </div>
    <a class="btn btn-primary next-step-btn" href="@nsUrl">@nsBtn</a>
</div>

<div class="card">
    <div class="card-head">
        <div>
            <h2>ملخص اليوم @Model.StatDate.ToString("yyyy-MM-dd")</h2>
            <div class="sub">كل الأرقام محسوبة من البيانات الفعلية للحضور والرواتب.</div>
        </div>
        <form method="get" class="btn-row">
            <input type="date" name="statDate" value="@Model.StatDate.ToString("yyyy-MM-dd")" />
            <select name="month">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == Model.Month)">@months[m - 1]</option>
                }
            </select>
            <input type="number" name="year" value="@Model.Year" style="width:90px" />
            <button type="submit" class="btn btn-primary">عرض</button>
        </form>
    </div>
</div>

<div class="stat-grid">
    <div class="stat">
        <div class="label">👥 الموظفون النشطون</div>
        <div class="value">@Model.ActiveEmployees</div>
        <div class="hint">موظف على العمل</div>
    </div>
    <div class="stat ok">
        <div class="label">✅ حاضرون اليوم</div>
        <div class="value">@Model.Present</div>
        <div class="hint">تم تسجيل بصمة دخول</div>
    </div>
    <div class="stat bad">
        <div class="label">🚫 غائبون اليوم</div>
        <div class="value">@Model.Absent</div>
        <div class="hint">بعد معالجة الحضور</div>
    </div>
    <div class="stat warn">
        <div class="label">⏰ متأخرون</div>
        <div class="value">@Model.Late</div>
        <div class="hint">تجاوزوا فترة السماح</div>
    </div>
    <div class="stat bad">
        <div class="label">🧩 بصمات ناقصة</div>
        <div class="value">@Model.MissingPunches</div>
        <div class="hint">دخول @Model.MissingEntry / خروج @Model.MissingExit</div>
    </div>
    <div class="stat warn">
        <div class="label">🔍 يحتاج مراجعة</div>
        <div class="value">@Model.NeedsReview</div>
        <div class="hint">وردية غامضة: @Model.AmbiguousShifts</div>
    </div>
    <div class="stat">
        <div class="label">🌴 إجازات اليوم</div>
        <div class="value">@Model.OnLeave</div>
        <div class="hint">مدفوعة وغير مدفوعة</div>
    </div>
    <div class="stat">
        <div class="label">📅 راحة/عطلة</div>
        <div class="value">@Model.RestOrHoliday</div>
        <div class="hint">جمعة أو عطلة رسمية</div>
    </div>
</div>

<div class="stat-grid">
    <div class="stat warn">
        <div class="label">⏱️ إضافي بانتظار الاعتماد</div>
        <div class="value">@Model.PendingOvertimeApprovals</div>
        <div class="hint">أيام بها إضافي خام غير معتمد</div>
    </div>
    <div class="stat">
        <div class="label">📈 إضافي الشهر (خام)</div>
        <div class="value">@Model.OvertimeHoursMonth <small>ساعة</small></div>
        <div class="hint">معتمد: @Model.ApprovedOvertimeHoursMonth ساعة</div>
    </div>
    <div class="stat bad">
        <div class="label">➖ خصومات الشهر</div>
        <div class="value">@Model.TotalDeductions.ToString("N2")</div>
        <div class="hint">خصومات معتمدة + سلف @Model.TotalLoans.ToString("N2")</div>
    </div>
    <div class="stat ok">
        <div class="label">💰 صافي كشف الشهر</div>
        <div class="value">@Model.TotalNetPayroll.ToString("N2") <small>@currency</small></div>
        <div class="hint">
            @if (Model.PayrollItemCount > 0)
            {
                <span>@Model.PayrollItemCount موظف — إجمالي @Model.TotalGrossPayroll.ToString("N2") — الحالة:</span>
                <span class="badge info">@ExcelExportService.PayrollStatusText((PayrollStatus)Model.PayrollStatus)</span>
            }
            else
            {
                <span>لم يُحتسب كشف لهذا الشهر بعد</span>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h3>ملخص الأقسام — @Model.StatDate.ToString("yyyy-MM-dd")</h3>
        <a class="btn btn-soft btn-sm" asp-controller="Reports" asp-action="Daily" asp-route-from="@Model.StatDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.StatDate.ToString("yyyy-MM-dd")">التقرير التفصيلي</a>
    </div>
    @if (Model.Departments.Count == 0)
    {
        ViewData["message"] = "لا يوجد موظفون مسجلون بعد. ابدأ بإضافة الموظفين أو استيرادهم من Excel.";
        ViewData["actionUrl"] = Url.Action("Import", "Employees");
        ViewData["actionText"] = "استيراد الموظفين من Excel";
        ViewData["icon"] = "🏢";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr>
                    <th>القسم</th><th>العدد</th><th>حضور</th><th>غياب</th><th>تأخير</th>
                    <th>إجازات</th><th>راحة/عطلة</th><th>مراجعة</th><th>نسبة الحضور</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Departments)
                {
                    <tr>
                        <td>@d.Department</td>
                        <td class="num">@d.Total</td>
                        <td class="num">@d.Present</td>
                        <td class="num">@d.Absent</td>
                        <td class="num">@d.Late</td>
                        <td class="num">@d.OnLeave</td>
                        <td class="num">@d.RestOrHoliday</td>
                        <td class="num">@d.NeedsReview</td>
                        <td style="min-width:120px">
                            <div class="bar"><span style="width:@(d.PresentRate)%"></span></div>
                            <span class="hint">@d.PresentRate%</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-head">
        <div>
            <h3>اتجاه صافي الرواتب — آخر 6 أشهر</h3>
            <div class="sub">من الكشوف غير الملغاة في قاعدة البيانات.</div>
        </div>
        <a class="btn btn-soft btn-sm" asp-controller="Reports" asp-action="Index">مركز التقارير</a>
    </div>
    @if (Model.PayrollTrend.Count == 0)
    {
        ViewData["message"] = "لا توجد كشوف رواتب بعد لعرض الاتجاه.";
        ViewData["hint"] = "احتسب كشف الشهر من صفحة المرتبات ليظهر هنا.";
        ViewData["icon"] = "💰";
        <partial name="_Empty" />
    }
    else
    {
        var maxNet = Model.PayrollTrend.Max(p => p.TotalNet);
        if (maxNet <= 0) { maxNet = 1; }
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>الفترة</th><th>الموظفون</th><th>صافي الكشف</th><th style="min-width:220px">الاتجاه</th></tr></thead>
                <tbody>
                @foreach (var p in Model.PayrollTrend)
                {
                    var pct = Math.Round(p.TotalNet * 100m / maxNet, 1);
                    <tr>
                        <td class="num"><a asp-controller="Payroll" asp-action="Index" asp-route-year="@p.Year" asp-route-month="@p.Month">@p.Label</a></td>
                        <td class="num">@p.ItemCount</td>
                        <td class="money">@p.TotalNet.ToString("N2")</td>
                        <td style="min-width:220px">
                            <div class="bar"><span style="width:@(pct)%"></span></div>
                            <span class="hint">@pct% من أعلى شهر</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-head">
        <h3>آخر عمليات استيراد البصمات</h3>
        <a class="btn btn-soft btn-sm" asp-controller="Import" asp-action="Index">استيراد ملف جديد</a>
    </div>
    @if (Model.LatestImports.Count == 0)
    {
        ViewData["message"] = "لم يتم استيراد أي ملف بصمات بعد.";
        ViewData["actionUrl"] = Url.Action("Index", "Import");
        ViewData["actionText"] = "استيراد ملف بصمات";
        ViewData["icon"] = "📄";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr><th>الملف</th><th>تاريخ الاستيراد</th><th>المستخدم</th><th>إجمالي</th><th>ناجح</th><th>مكرر</th><th>غير صالح</th><th>موظف غير معروف</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var b in Model.LatestImports)
                {
                    <tr>
                        <td class="wrap">@b.FileName</td>
                        <td class="num">@b.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(b.ImportedByName ?? "-")</td>
                        <td class="num">@b.TotalRows</td>
                        <td class="num">@b.SuccessRows</td>
                        <td class="num">@b.DuplicateRows</td>
                        <td class="num">@b.InvalidRows</td>
                        <td class="num">@b.UnknownEmployeeRows</td>
                        <td><a class="btn btn-ghost btn-sm" asp-controller="Import" asp-action="Details" asp-route-id="@b.Id">عرض</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-head"><h3>المسار اليومي المعتاد</h3></div>
    <div class="card-body btn-row">
        <a class="btn btn-soft" asp-controller="Import" asp-action="Index">1) استيراد البصمات</a>
        <a class="btn btn-soft" asp-controller="Attendance" asp-action="Index">2) مراجعة الحضور</a>
        <a class="btn btn-soft" asp-controller="Overtime" asp-action="Index">3) اعتماد الإضافي</a>
        <a class="btn btn-soft" asp-controller="Reports" asp-action="Daily">4) التقرير اليومي</a>
        <a class="btn btn-soft" asp-controller="Payroll" asp-action="Index">5) احتساب الرواتب</a>
    </div>
</div>
