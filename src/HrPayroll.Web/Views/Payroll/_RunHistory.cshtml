@using HrPayroll.Domain.Enums
@using HrPayroll.Infrastructure.Services
@model HrPayroll.Web.ViewModels.PayrollIndexViewModel
<div class="card">
    <div class="card-head">
        <h3>سجل الكشوف السابقة</h3>
        <div class="sub">أحدث 24 كشفًا — اضغط «عرض» لفتح كشف شهر محدد.</div>
    </div>
    @if (Model.Runs.Count == 0)
    {
        ViewData["message"] = "لا توجد كشوف سابقة";
        ViewData["icon"] = "🗓️";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr>
                    <th>الفترة</th><th>الإصدار</th><th>الحالة</th><th>محسوب بواسطة</th>
                    <th>وقت الاحتساب</th><th class="th-money">إجمالي الاستحقاقات</th>
                    <th class="th-money">إجمالي الخصومات</th><th class="th-money">صافي الكشف</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Runs)
                {
                    <tr>
                        <td class="num">@r.Year-@r.Month.ToString("00")</td>
                        <td class="num">@r.Version</td>
                        <td>
                            <span class="badge @(r.Status is PayrollStatus.Approved or PayrollStatus.Locked ? "ok" : r.Status == PayrollStatus.Cancelled ? "muted" : "info")">
                                @ExcelExportService.PayrollStatusText(r.Status)
                            </span>
                        </td>
                        <td>@(r.ComputedBy ?? "-")</td>
                        <td class="num">@(r.ComputedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td class="money">@r.TotalGross.ToString("N2")</td>
                        <td class="money">@r.TotalDeductions.ToString("N2")</td>
                        <td class="money">@r.TotalNet.ToString("N2")</td>
                        <td class="act-cell">
                            <a class="btn btn-soft btn-sm" asp-action="Index" asp-route-year="@r.Year" asp-route-month="@r.Month">فتح</a>
                            <a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@r.Id">تفاصيل</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
